# ==============================================
# CONFIGURAZIONE DOCKER - AMORUSO PASS DASHBOARD
# ==============================================
# Copia questo file in .env e modifica i valori

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_ROOT_PASSWORD=secure_root_password_change_this
DB_NAME=amoruso_pass_db
DB_USER=amoruso_user
DB_PASSWORD=secure_db_password_change_this
DB_PORT=3306

# URL completo del database (costruito automaticamente)
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@database:3306/${DB_NAME}

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
APP_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================================
# JWT & AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this-in-production
NEXTAUTH_SECRET=your-super-secret-nextauth-key-minimum-32-characters-long-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# ==============================================
# EMAIL CONFIGURATION (OVH)
# ==============================================
SMTP_HOST=smtp.ovh.net
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=your-email@yourdomain.com

# ==============================================
# ALTERNATIVE EMAIL PROVIDERS
# ==============================================

# Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com

# Outlook/Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your-email@outlook.com

# ==============================================
# OPTIONAL: ANALYTICS & MONITORING
# ==============================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS=false
# NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-xxxxxxxxxx

# ==============================================
# ENVIRONMENT
# ==============================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
