# Configurazione per deployment su http://salernocruises.it:8000/

# Database
DATABASE_URL="postgresql://username:password@your-db-host:5432/amoruso_pass_db"

# JWT Secret (cambiare con una chiave sicura)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="http://salernocruises.it:8000"

# Email Configuration
SMTP_HOST="smtp.ovh.net"
SMTP_PORT="587"
SMTP_USER="your-email@salernocruises.it"
SMTP_PASSWORD="your-email-password"
SMTP_FROM="your-email@salernocruises.it"

# Environment
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"

# Port
PORT="8000"

# Optional: Se vuoi usare docker-compose
APP_PORT="8000"
