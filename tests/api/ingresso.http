POST {{baseUrl}}/api/ingressi
Content-Type: {{contentType}}

{
  "email": "auto-test-1@amoruso.com",
  "ragione_sociale": "Auto Test 1 SRL",
  "targa": "AAAAAAAA",
  "partita_iva": "12345678901",
  "indirizzo": "Via Roma 123, Milano",
  "importo": 25.50
}

