# ==============================================
# AMORUSO PASS DASHBOARD - DATABASE ESTERNO
# ==============================================

# ==============================================
# DATABASE ESTERNO
# ==============================================
# Configura la connessione al tuo database esistente
DATABASE_URL=mysql://username:password@host:port/database_name

# Esempio per database locale:
# DATABASE_URL=mysql://amoruso_user:password@localhost:3306/amoruso_pass_db

# Esempio per database remoto:
# DATABASE_URL=mysql://user:pass@db.example.com:3306/amoruso_db

# ==============================================
# APPLICATION
# ==============================================
APP_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==============================================
# JWT & AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
NEXTAUTH_SECRET=your-super-secret-nextauth-key-minimum-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=smtp.ovh.net
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=your-email@yourdomain.com

# ==============================================
# ENVIRONMENT
# ==============================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
